generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth.js ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  calendarToken String?   @unique

  accounts         Account[]
  sessions         Session[]
  listEntries      ListEntry[]
  diaryEntries     DiaryEntry[]
  rankedItems      RankedItem[]
  pushSubscriptions PushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Catalogue ----------

enum MediaType {
  ANIME
  MANGA
}

enum MediaStatus {
  FINISHED
  RELEASING
  NOT_YET_RELEASED
  CANCELLED
  HIATUS
}

model Media {
  id          String      @id @default(cuid())
  anilistId   Int         @unique
  type        MediaType
  titleRomaji String
  titleEnglish String?
  titleNative String?
  synopsis    String?     @db.Text
  coverUrl    String?
  bannerUrl   String?
  color       String?
  episodes    Int?
  chapters    Int?
  duration    Int?
  status      MediaStatus?
  season      String?
  seasonYear  Int?
  genres      String[]
  studio      String?
  nextAiringAt    DateTime?
  nextEpisode     Int?
  lastAiringAt      DateTime?
  lastAiringEpisode Int?
  episodeSchedule   Json?

  streamingLinks StreamingLink[]
  listEntries    ListEntry[]
  diaryEntries   DiaryEntry[]
  rankedItems    RankedItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
  @@index([nextAiringAt])
}

model StreamingLink {
  id      String  @id @default(cuid())
  mediaId String
  site    String
  url     String
  isFree  Boolean @default(false)

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
}

// ---------- Suivi utilisateur ----------

enum ListStatus {
  WATCHING
  PLANNING
  COMPLETED
  DROPPED
}

model ListEntry {
  id        String     @id @default(cuid())
  userId    String
  mediaId   String
  status    ListStatus @default(PLANNING)
  progress  Int        @default(0)
  rating    Decimal?   @db.Decimal(2, 1)
  liked     Boolean    @default(false)
  review    String?    @db.Text
  spoiler   Boolean    @default(false)
  notify    Boolean    @default(true)
  notifiedEpisode Int?
  startedAt  DateTime?
  finishedAt DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, mediaId])
  @@index([userId, status])
}

model DiaryEntry {
  id        String   @id @default(cuid())
  userId    String
  mediaId   String
  watchedAt DateTime @default(now())
  rating    Decimal? @db.Decimal(2, 1)
  review    String?  @db.Text
  spoiler   Boolean  @default(false)
  isRewatch Boolean  @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, watchedAt])
}

enum RankTier {
  ADORE
  BIEN
  BOF
}

model RankedItem {
  id        String    @id @default(cuid())
  userId    String
  mediaId   String
  mediaType MediaType
  tier      RankTier
  position  Int
  score     Decimal   @db.Decimal(3, 1)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, mediaId])
  @@index([userId, mediaType, tier, position])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}
