# Base de données (Neon ou Supabase — connexion directe Postgres, pooling recommandé en prod)
# En local sans Neon/Supabase, `npx prisma dev` lance une Postgres locale et affiche l'URL à coller ici.
DATABASE_URL="postgresql://user:password@host:5432/nami?schema=public"

# Auth.js — générer avec `npx auth secret`
AUTH_SECRET=""

# Connexion Google (console.cloud.google.com > Identifiants OAuth)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Magic link par e-mail (SMTP — ex: Resend, Mailtrap, etc.)
EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="Nami <no-reply@nami.app>"

# AniList (API publique, pas de clé requise pour les requêtes en lecture)
ANILIST_API_URL="https://graphql.anilist.co"

# URL publique de déploiement (sert à résoudre les images Open Graph)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Compte propriétaire utilisé sans connexion (usage personnel)
OWNER_EMAIL="toi@exemple.com"
